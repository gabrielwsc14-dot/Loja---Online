<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Permite acesso direto a arquivos em /server/
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Redireciona URLs não encontradas para index.html
  RewriteRule ^(.*)$ index.html [L]
</IfModule>
